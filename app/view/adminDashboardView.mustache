{{> header}}

<main class="admin-dashboard">
    <form method="POST" action="{{baseUrl}}/admin/filtrar" class="admin-filtros">
        <div>
            <label for="periodo">Filtrar totales por:</label>
            <select name="periodo" id="periodo">
                <option value="todo" {{#es_todo}}selected{{/es_todo}}>Histórico completo</option>
                <option value="dia" {{#es_dia}}selected{{/es_dia}}>Día</option>
                <option value="mes" {{#es_mes}}selected{{/es_mes}}>Mes</option>
                <option value="anio" {{#es_anio}}selected{{/es_anio}}>Año</option>
            </select>
        </div>

        <div>
            <label for="fecha">Fecha de referencia:</label>
            <input type="date" name="fecha" id="fecha" value="{{fecha_actual}}">
        </div>

        <div>
            <label for="agrupar">Evolución de gráficos:</label>
            <select name="agrupar" id="agrupar">
                <option value="dia" {{#agrupar_dia}}selected{{/agrupar_dia}}>Por Día</option>
                <option value="mes" {{#agrupar_mes}}selected{{/agrupar_mes}}>Por Mes</option>
                <option value="anio" {{#agrupar_anio}}selected{{/agrupar_anio}}>Por Año</option>
            </select>
        </div>

        <button type="submit">Aplicar</button>
        <a href="{{baseUrl}}/admin/limpiarFiltros">Limpiar</a>
    </form>

    <nav class="admin-indice">
        <a href="#seccion-graficos">Gráficos</a>
        <a href="#seccion-tablas">Tablas</a>
        <a href="#tabla-pais">País</a>
        <a href="#tabla-sexo">Sexo</a>
        <a href="#tabla-edad">Edad</a>
        <a href="#tabla-usuarios">Usuarios</a>
        <button type="button" class="admin-imprimir" onclick="window.print()">Imprimir reportes</button>
    </nav>

    <section class="admin-kpis">
        <article class="kpi-card">
            <span>Jugadores Registrados</span>
            <strong>{{total_jugadores}}</strong>
        </article>
        <article class="kpi-card">
            <span>Partidas Jugadas</span>
            <strong>{{total_partidas}}</strong>
        </article>
        <article class="kpi-card">
            <span>Preguntas Creadas</span>
            <strong>{{total_preguntas}}</strong>
        </article>
    </section>

    <section class="admin-graficos" id="seccion-graficos">
        <div class="chart-box">
            <h3>Partidas Jugadas</h3>
            <div class="chart-container">
                <canvas id="chartPartidas"
                        data-labels='{{{partidas_labels}}}'
                        data-values='{{{partidas_values}}}'></canvas>
            </div>
        </div>

        <div class="chart-box">
            <h3>Nuevos Jugadores</h3>
            <div class="chart-container">
                <canvas id="chartJugadores"
                        data-labels='{{{jugadores_labels}}}'
                        data-values='{{{jugadores_values}}}'></canvas>
            </div>
        </div>

        <div class="chart-box">
            <h3>Preguntas por Categoría</h3>
            <div class="chart-container">
                <canvas id="chartCategorias"
                        data-labels='{{{categorias_labels}}}'
                        data-values='{{{categorias_values}}}'
                        data-colors='{{{categorias_colors}}}'></canvas>
            </div>
        </div>
    </section>

    <section class="admin-tablas" id="seccion-tablas">
        <h2 class="reporte-titulo">{{titulo_reporte}}</h2>

        <div class="tabla-box" id="tabla-partidas">
            <h3>Partidas jugadas</h3>
            <table class="tabla-datos">
                <thead><tr><th>Período</th><th>Partidas</th></tr></thead>
                <tbody>
                {{#tabla_partidas}}<tr><td>{{etiqueta}}</td><td>{{total}}</td></tr>{{/tabla_partidas}}
                </tbody>
            </table>
            {{#pag_partidas}}{{#hay_paginas}}
                <nav class="paginado" aria-label="Paginado partidas">
                    {{#hay_anterior}}<a href="{{baseUrl}}/admin/dashboard?pagina_partidas={{pagina_anterior}}&pagina_jugadores={{pagina_jugadores}}&pagina_usuarios={{pagina_usuarios}}#tabla-partidas">&laquo; Anterior</a>{{/hay_anterior}}
                    <span>Página {{pagina}} de {{total_paginas}}</span>
                    {{#hay_siguiente}}<a href="{{baseUrl}}/admin/dashboard?pagina_partidas={{pagina_siguiente}}&pagina_jugadores={{pagina_jugadores}}&pagina_usuarios={{pagina_usuarios}}#tabla-partidas">Siguiente &raquo;</a>{{/hay_siguiente}}
                </nav>
            {{/hay_paginas}}{{/pag_partidas}}
        </div>

        <div class="tabla-box" id="tabla-jugadores">
            <h3>Nuevos jugadores</h3>
            <table class="tabla-datos">
                <thead><tr><th>Período</th><th>Jugadores</th></tr></thead>
                <tbody>
                {{#tabla_jugadores}}<tr><td>{{etiqueta}}</td><td>{{total}}</td></tr>{{/tabla_jugadores}}
                </tbody>
            </table>
            {{#pag_jugadores}}{{#hay_paginas}}
                <nav class="paginado" aria-label="Paginado jugadores">
                    {{#hay_anterior}}<a href="{{baseUrl}}/admin/dashboard?pagina_partidas={{pagina_partidas}}&pagina_jugadores={{pagina_anterior}}&pagina_usuarios={{pagina_usuarios}}#tabla-jugadores">&laquo; Anterior</a>{{/hay_anterior}}
                    <span>Página {{pagina}} de {{total_paginas}}</span>
                    {{#hay_siguiente}}<a href="{{baseUrl}}/admin/dashboard?pagina_partidas={{pagina_partidas}}&pagina_jugadores={{pagina_siguiente}}&pagina_usuarios={{pagina_usuarios}}#tabla-jugadores">Siguiente &raquo;</a>{{/hay_siguiente}}
                </nav>
            {{/hay_paginas}}{{/pag_jugadores}}
        </div>

        <div class="tabla-box">
            <h3>Preguntas por categoría</h3>
            <table class="tabla-datos">
                <thead><tr><th>Categoría</th><th>Preguntas</th></tr></thead>
                <tbody>
                {{#tabla_categorias}}<tr><td>{{categoria}}</td><td>{{total}}</td></tr>{{/tabla_categorias}}
                </tbody>
            </table>
        </div>

        <div class="tabla-box" id="tabla-pais">
            <h3>Usuarios por país</h3>
            <table class="tabla-datos">
                <thead><tr><th>País</th><th>Usuarios</th></tr></thead>
                <tbody>
                {{#por_pais}}<tr><td>{{grupo}}</td><td>{{total}}</td></tr>{{/por_pais}}
                </tbody>
            </table>
        </div>

        <div class="tabla-box" id="tabla-sexo">
            <h3>Usuarios por sexo</h3>
            <table class="tabla-datos">
                <thead><tr><th>Sexo</th><th>Usuarios</th></tr></thead>
                <tbody>
                {{#por_sexo}}<tr><td>{{grupo}}</td><td>{{total}}</td></tr>{{/por_sexo}}
                </tbody>
            </table>
        </div>

        <div class="tabla-box" id="tabla-edad">
            <h3>Usuarios por grupo de edad</h3>
            <table class="tabla-datos">
                <thead><tr><th>Grupo</th><th>Usuarios</th></tr></thead>
                <tbody>
                {{#por_edad}}<tr><td>{{grupo}}</td><td>{{total}}</td></tr>{{/por_edad}}
                </tbody>
            </table>
        </div>

        <div class="tabla-box" id="tabla-usuarios">
            <h3>Respuestas correctas por usuario (histórico)</h3>
            <table class="tabla-datos">
                <thead><tr><th>Usuario</th><th>Correctas</th><th>Respondidas</th><th>%</th></tr></thead>
                <tbody>
                {{#por_usuario}}<tr><td>{{usuario}}</td><td>{{correctas}}</td><td>{{respondidas}}</td><td>{{porcentaje}}%</td></tr>{{/por_usuario}}
                </tbody>
            </table>
            {{#pag_usuarios}}{{#hay_paginas}}
                <nav class="paginado" aria-label="Paginado usuarios">
                    {{#hay_anterior}}<a href="{{baseUrl}}/admin/dashboard?pagina_partidas={{pagina_partidas}}&pagina_jugadores={{pagina_jugadores}}&pagina_usuarios={{pagina_anterior}}#tabla-usuarios">&laquo; Anterior</a>{{/hay_anterior}}
                    <span>Página {{pagina}} de {{total_paginas}}</span>
                    {{#hay_siguiente}}<a href="{{baseUrl}}/admin/dashboard?pagina_partidas={{pagina_partidas}}&pagina_jugadores={{pagina_jugadores}}&pagina_usuarios={{pagina_siguiente}}#tabla-usuarios">Siguiente &raquo;</a>{{/hay_siguiente}}
                </nav>
            {{/hay_paginas}}{{/pag_usuarios}}
        </div>
    </section>
</main>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script src="{{baseUrl}}/public/javascript/admin-metricas.js"></script>

{{> footer}}