{{> header}}
<main class="pregunta activas">
    {{> editorIconosPreguntas}}

    <section class="pregunta__tarjeta activas__panel" aria-labelledby="activas-titulo">
        <div class="activas__encabezado">
            <img src="{{baseUrl}}/public/img/portapapeles.png" width="1293" height="1216" alt="">
            <div>
                <h1 class="pregunta__titulo" id="activas-titulo">Preguntas activas</h1>
                <p class="pregunta__subtitulo">Preguntas que están hoy en el juego.</p>
            </div>
        </div>

        <nav class="activas__navegacion" aria-label="Navegación del editor">
            <a class="pregunta__boton pregunta__boton--enlace activas__boton activas__boton--volver" href="{{baseUrl}}/editor/show">
                 Volver al panel
            </a>
            <a class="pregunta__boton pregunta__boton--enlace activas__boton" href="{{baseUrl}}/editor/inactivas">
           Ver preguntas inactivas
            </a>
        </nav>

        {{> editorFiltrosPreguntas}}

        {{#sin_resultados}}
            <p class="pregunta__subtitulo" role="status">
                {{#hay_filtros}}No hay preguntas que coincidan con los filtros.{{/hay_filtros}}
                {{^hay_filtros}}No hay preguntas activas.{{/hay_filtros}}
            </p>
        {{/sin_resultados}}

        {{#sin_activas}}
            <p class="pregunta__subtitulo" role="status">No hay preguntas activas.</p>
        {{/sin_activas}}

        {{#preguntas}}
            <article class="revision activas__pregunta" data-categoria="{{categoria}}">
                <h2 class="revision__enunciado">{{enunciado}}</h2>
                <div class="revision__datos">
                    <span class="activas__categoria"><svg class="activas__icono" aria-hidden="true"><use href="#activas-icono-categoria"/></svg> {{categoria}}</span>
                    {{#categoria_inactiva}}
                        <span class="revision__categoria-inactiva">Categoría inactiva</span>
                    {{/categoria_inactiva}}
                    <span><svg class="activas__icono" aria-hidden="true"><use href="#activas-icono-usuario"/></svg> Creada por {{creador}}</span>
                    <span><svg class="activas__icono" aria-hidden="true"><use href="#activas-icono-fecha"/></svg> {{fecha_creacion}}</span>
                </div>

                <details class="revision__detalle">
                    <summary>Ver respuestas</summary>
                    <ul class="revision__respuestas">
                        {{#respuestas}}
                            <li class="revision__respuesta {{#es_correcta}}revision__respuesta--correcta{{/es_correcta}}">
                                {{texto}} {{#es_correcta}}✅{{/es_correcta}}
                            </li>
                        {{/respuestas}}
                    </ul>
                </details>

                <div class="revision__acciones">
                    <a class="pregunta__boton pregunta__boton--enlace activas__boton activas__boton--editar" href="{{baseUrl}}/pregunta/editar?id={{id}}">
                        <svg class="activas__icono" aria-hidden="true"><use href="#activas-icono-editar"/></svg> Editar
                    </a>
                    <button class="pregunta__boton activas__boton activas__boton--baja" type="button"
                            aria-haspopup="dialog" aria-controls="pregunta-baja"
                            data-pregunta-baja-id="{{id}}" data-pregunta-baja-enunciado="{{enunciado}}">
                        <svg class="activas__icono" aria-hidden="true"><use href="#activas-icono-baja"/></svg> Dar de baja
                    </button>
                </div>
            </article>
        {{/preguntas}}
        {{#hay_paginas}}
            <nav class="paginado" aria-label="Paginado">
                {{#hay_anterior}}<a href="{{baseUrl}}/editor/activas?pagina={{pagina_anterior}}&q={{busqueda_url}}&categoria={{categoria_actual}}">&laquo; Anterior</a>{{/hay_anterior}}
                <span>Página {{pagina}} de {{total_paginas}}</span>
                {{#hay_siguiente}}<a href="{{baseUrl}}/editor/activas?pagina={{pagina_siguiente}}&q={{busqueda_url}}&categoria={{categoria_actual}}">Siguiente &raquo;</a>{{/hay_siguiente}}
            </nav>
        {{/hay_paginas}}
    </section>

    <dialog id="pregunta-baja" class="activas__dialogo" aria-labelledby="pregunta-baja-titulo"
            aria-describedby="pregunta-baja-enunciado pregunta-baja-mensaje">
        <h2 class="pregunta__titulo" id="pregunta-baja-titulo">Dar de baja la pregunta</h2>
        <p class="pregunta__subtitulo" id="pregunta-baja-enunciado"></p>
        <p class="pregunta__subtitulo" id="pregunta-baja-mensaje">La pregunta saldrá del juego. Podés reactivarla desde Preguntas inactivas.</p>
        <form method="POST" action="{{baseUrl}}/editor/baja" class="revision__acciones">
            <input type="hidden" name="id" id="pregunta-baja-id">
            <button class="pregunta__boton activas__boton activas__boton--volver" id="pregunta-baja-cancelar" type="button" autofocus>Cancelar</button>
            <button class="pregunta__boton activas__boton activas__boton--baja" type="submit">Confirmar baja</button>
        </form>
    </dialog>
</main>

<script src="{{baseUrl}}/public/javascript/preguntas-activas.js" defer></script>
{{> footer}}
