{{> header}}
<main class="pregunta activas">
    <svg class="activas__simbolos" width="0" height="0" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
        <symbol id="activas-icono-volver" viewBox="0 0 24 24"><path d="M19 12H5m6-6-6 6 6 6"/></symbol>
        <symbol id="activas-icono-ver" viewBox="0 0 24 24"><path d="M2 12s4-6 10-6 10 6 10 6-4 6-10 6S2 12 2 12Zm13 0a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z"/></symbol>
        <symbol id="activas-icono-buscar" viewBox="0 0 24 24"><path d="M21 21l-5-5m2-5a7 7 0 1 1-14 0 7 7 0 0 1 14 0Z"/></symbol>
        <symbol id="activas-icono-categoria" viewBox="0 0 24 24"><path d="M3 4h8l10 10-7 7L3 10V4Zm4 4h.01"/></symbol>
        <symbol id="activas-icono-usuario" viewBox="0 0 24 24"><path d="M4 21v-2a5 5 0 0 1 5-5h6a5 5 0 0 1 5 5v2m-4-14a4 4 0 1 1-8 0 4 4 0 0 1 8 0Z"/></symbol>
        <symbol id="activas-icono-fecha" viewBox="0 0 24 24"><path d="M5 5h14a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2Zm2-2v4m10-4v4M3 10h18"/></symbol>
        <symbol id="activas-icono-editar" viewBox="0 0 24 24"><path d="m4 16-1 5 5-1L21 7l-4-4L4 16Zm10-10 4 4M4 16l4 4"/></symbol>
        <symbol id="activas-icono-baja" viewBox="0 0 24 24"><path d="M3 6h18M9 6V3h6v3M5 6l1 15h12l1-15m-9 4v7m4-7v7"/></symbol>
    </svg>

    <section class="pregunta__tarjeta activas__panel" aria-labelledby="activas-titulo">
        <div class="activas__encabezado">
            <img src="{{baseUrl}}/public/img/portapapeles.png" width="1293" height="1216" alt="">
            <div>
                <h1 class="pregunta__titulo" id="activas-titulo">Preguntas activas</h1>
                <p class="pregunta__subtitulo">Preguntas que están hoy en el juego.</p>
            </div>
        </div>

        <nav class="activas__navegacion" aria-label="Navegación del editor">
            <a class="pregunta__boton pregunta__boton--enlace activas__boton activas__boton--volver" href="{{baseUrl}}/editor/show">
                 Volver al panel
            </a>
            <a class="pregunta__boton pregunta__boton--enlace activas__boton" href="{{baseUrl}}/editor/inactivas">
           Ver preguntas inactivas
            </a>
        </nav>

        <form class="activas__filtros" method="GET" action="{{baseUrl}}/editor/activas">
            <label class="activas__filtro">
                <svg class="activas__icono" aria-hidden="true"><use href="#activas-icono-buscar"/></svg>
                <input class="pregunta__entrada" name="q" type="search" value="{{busqueda}}" aria-label="Buscar por enunciado" placeholder="Buscar pregunta...">
            </label>
            <label class="activas__filtro">
                <svg class="activas__icono" aria-hidden="true"><use href="#activas-icono-categoria"/></svg>
                <select class="pregunta__entrada" name="categoria" aria-label="Filtrar por categoría">
                    <option value="0">Todas las categorías</option>
                    {{#categorias}}
                        <option value="{{id}}" {{#seleccionada}}selected{{/seleccionada}}>{{nombre}}</option>
                    {{/categorias}}
                </select>
            </label>
            <div class="activas__filtros-acciones">
                <button class="pregunta__boton activas__boton" type="submit">Filtrar</button>
                {{#hay_filtros}}<a class="pregunta__boton pregunta__boton--enlace activas__boton activas__boton--volver" href="{{baseUrl}}/editor/activas">Limpiar</a>{{/hay_filtros}}
            </div>
        </form>

        {{#sin_resultados}}
            <p class="pregunta__subtitulo" role="status">
                {{#hay_filtros}}No hay preguntas que coincidan con los filtros.{{/hay_filtros}}
                {{^hay_filtros}}No hay preguntas activas.{{/hay_filtros}}
            </p>
        {{/sin_resultados}}

        {{#sin_activas}}
            <p class="pregunta__subtitulo" role="status">No hay preguntas activas.</p>
        {{/sin_activas}}

        {{#preguntas}}
            <article class="revision activas__pregunta" data-categoria="{{categoria}}">
                <h2 class="revision__enunciado">{{enunciado}}</h2>
                <div class="revision__datos">
                    <span class="activas__categoria"><svg class="activas__icono" aria-hidden="true"><use href="#activas-icono-categoria"/></svg> {{categoria}}</span>
                    <span><svg class="activas__icono" aria-hidden="true"><use href="#activas-icono-usuario"/></svg> Creada por {{creador}}</span>
                    <span><svg class="activas__icono" aria-hidden="true"><use href="#activas-icono-fecha"/></svg> {{fecha_creacion}}</span>
                </div>

                <details class="revision__detalle">
                    <summary>Ver respuestas</summary>
                    <ul class="revision__respuestas">
                        {{#respuestas}}
                            <li class="revision__respuesta {{#es_correcta}}revision__respuesta--correcta{{/es_correcta}}">
                                {{texto}} {{#es_correcta}}✅{{/es_correcta}}
                            </li>
                        {{/respuestas}}
                    </ul>
                </details>

                <div class="revision__acciones">
                    <a class="pregunta__boton pregunta__boton--enlace activas__boton activas__boton--editar" href="{{baseUrl}}/pregunta/editar?id={{id}}">
                        <svg class="activas__icono" aria-hidden="true"><use href="#activas-icono-editar"/></svg> Editar
                    </a>
                    <form method="POST" action="{{baseUrl}}/editor/baja">
                        <input type="hidden" name="id" value="{{id}}">
                        <button class="pregunta__boton activas__boton activas__boton--baja" type="submit">
                            <svg class="activas__icono" aria-hidden="true"><use href="#activas-icono-baja"/></svg> Dar de baja
                        </button>
                    </form>
                </div>
            </article>
        {{/preguntas}}
        {{#hay_paginas}}
            <nav class="paginado" aria-label="Paginado">
                {{#hay_anterior}}<a href="{{baseUrl}}/editor/activas?pagina={{pagina_anterior}}&q={{busqueda_url}}&categoria={{categoria_actual}}">&laquo; Anterior</a>{{/hay_anterior}}
                <span>Página {{pagina}} de {{total_paginas}}</span>
                {{#hay_siguiente}}<a href="{{baseUrl}}/editor/activas?pagina={{pagina_siguiente}}&q={{busqueda_url}}&categoria={{categoria_actual}}">Siguiente &raquo;</a>{{/hay_siguiente}}
            </nav>
        {{/hay_paginas}}
    </section>
</main>

{{> footer}}
