{{> header}}
<main class="pregunta">
    <section class="pregunta__tarjeta">
        <h1 class="pregunta__titulo">Panel del editor</h1>
        <p class="pregunta__subtitulo">Preguntas sugeridas por jugadores, pendientes de revisión.</p>

        <a class="pregunta__boton pregunta__boton--enlace" href="{{baseUrl}}/pregunta/crear">Crear pregunta</a>
        <a class="pregunta__boton pregunta__boton--enlace" href="{{baseUrl}}/editor/activas">Ver preguntas activas</a>

        {{#sin_pendientes}}
            <p class="pregunta__exito" role="status">No hay preguntas pendientes. ¡Todo al día!</p>
        {{/sin_pendientes}}

        {{#preguntas}}
            <article class="revision">
                <p class="revision__enunciado">{{enunciado}}</p>
                <p class="revision__datos">
                    Categoría: {{categoria}} · Sugerida por {{creador}} · {{fecha_creacion}}
                </p>

                <ul class="revision__respuestas">
                    {{#respuestas}}
                        <li class="revision__respuesta {{#es_correcta}}revision__respuesta--correcta{{/es_correcta}}">
                            {{texto}} {{#es_correcta}}✅{{/es_correcta}}
                        </li>
                    {{/respuestas}}
                </ul>

                <div class="revision__acciones">
                    <form method="POST" action="{{baseUrl}}/editor/aprobar">
                        <input type="hidden" name="id" value="{{id}}">
                        <button class="pregunta__boton" type="submit">Aprobar</button>
                    </form>
                    <form method="POST" action="{{baseUrl}}/editor/rechazar">
                        <input type="hidden" name="id" value="{{id}}">
                        <button class="pregunta__boton revision__rechazar" type="submit">Rechazar</button>
                    </form>
                </div>
            </article>
        {{/preguntas}}
    </section>
</main>

{{> footer}}