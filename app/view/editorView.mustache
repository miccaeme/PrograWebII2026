{{> header}}
<main class="pregunta panel-editor">
    <section class="pregunta__tarjeta panel-editor__contenedor" aria-labelledby="panel-editor-titulo">
        <div class="panel-editor__encabezado">
            <img class="panel-editor__personaje" src="{{baseUrl}}/public/img/cerebrito-feliz.png" width="1363" height="1154" alt="">
            <div class="panel-editor__introduccion">
                <h1 class="pregunta__titulo panel-editor__titulo" id="panel-editor-titulo">
                    <span class="panel-editor__corona" aria-hidden="true">👑</span>
                    Panel del editor
                </h1>

            </div>
        </div>

        <nav class="panel-editor__grilla" aria-label="Funciones del editor">
            <a class="panel-editor__acceso panel-editor__acceso--violeta" href="{{baseUrl}}/pregunta/crear">
                <span class="panel-editor__icono" aria-hidden="true">+</span>
                <span><strong>Crear pregunta</strong></span>

            </a>
            <a class="panel-editor__acceso panel-editor__acceso--verde" href="{{baseUrl}}/categoria/crear">
                <span class="panel-editor__icono" aria-hidden="true">◇</span>
                <span><strong>Crear categoría</strong></span>

            </a>
            <a class="panel-editor__acceso panel-editor__acceso--celeste" href="{{baseUrl}}/editor/activas">
                <span class="panel-editor__icono" aria-hidden="true">▶</span>
                <span><strong>Ver preguntas activas</strong></span>

            </a>


            <a class="panel-editor__acceso panel-editor__acceso--rosa" href="{{baseUrl}}/categoria/show">
                <span class="panel-editor__icono" aria-hidden="true">▦</span>
                <span><strong>Ver categorías</strong></span>

            </a>
            <a class="panel-editor__acceso panel-editor__acceso--amarillo" href="{{baseUrl}}/editor/inactivas">
                <span class="panel-editor__icono" aria-hidden="true">Ⅱ</span>
                <span><strong>Ver preguntas inactivas</strong></span>

            </a>
            <a class="panel-editor__acceso panel-editor__acceso--durazno" href="{{baseUrl}}/editor/reportadas">
                <span class="panel-editor__icono" aria-hidden="true">!</span>
                <span><strong>Ver preguntas reportadas</strong></span>

            </a>
        </nav>

        <h2 class="panel-editor__pendientes">Preguntas pendientes de revisión</h2>

        {{#sin_pendientes}}
            <p class="pregunta__exito" role="status">No hay preguntas pendientes. ¡Todo al día!</p>
        {{/sin_pendientes}}

        {{#preguntas}}
            <article class="revision">
                <p class="revision__enunciado">{{enunciado}}</p>
                <p class="revision__datos">
                    Categoría: {{categoria}} · Sugerida por {{creador}} · {{fecha_creacion}}
                </p>

                <ul class="revision__respuestas">
                    {{#respuestas}}
                        <li class="revision__respuesta {{#es_correcta}}revision__respuesta--correcta{{/es_correcta}}">
                            {{texto}} {{#es_correcta}}✅{{/es_correcta}}
                        </li>
                    {{/respuestas}}
                </ul>

                <div class="revision__acciones">
                    <form method="POST" action="{{baseUrl}}/editor/aprobar">
                        <input type="hidden" name="id" value="{{id}}">
                        <button class="pregunta__boton" type="submit">Aprobar</button>
                    </form>
                    <form method="POST" action="{{baseUrl}}/editor/rechazar">
                        <input type="hidden" name="id" value="{{id}}">
                        <button class="pregunta__boton revision__rechazar" type="submit">Rechazar</button>
                    </form>
                </div>
            </article>
        {{/preguntas}}
    </section>
</main>

{{> footer}}
