
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Cerebrito | Juego de preguntas</title>
    <link rel="stylesheet" href="{{baseUrl}}/public/css/header.css">
    <link rel="stylesheet" href="{{baseUrl}}/public/css/footer.css">
    <link rel="stylesheet" href="{{baseUrl}}/public/css/app.css">
    <link rel="stylesheet" href="{{baseUrl}}/public/css/registro.css">
    <link rel="stylesheet" href="{{baseUrl}}/public/css/login.css">
    <link rel="stylesheet" href="{{baseUrl}}/public/css/lobby.css">
    <link rel="stylesheet" href="{{baseUrl}}/public/css/perfil.css">
</head>
<body>
<header class="header">
    <div class="header__container">
        <a href="{{baseUrl}}/" class="header__logo">
            <img src="{{baseUrl}}/public/img/logo.png" alt="Logo Cerebrito">
        </a>
        <button class="header__menu-toggle" type="button" aria-label="Abrir menú;" aria-expanded="false" aria-controls="header-menu">
            <span></span><span></span><span></span>
        </button>
        <div class="header__menu" id="header-menu">
            <nav class="header__nav" aria-label="Navegación principal">
                <a href="{{baseUrl}}/" class="header__link">Inicio</a>
                <a href="#" class="header__link">Categorías</a>
                <a href="#" class="header__link">Ranking</a>
            </nav>
            <div class="header__actions">
                {{#logueado}}
                    <span class="usuario-badge">¡Hola, {{nombre_usuario}}!</span>
                    <a href="{{baseUrl}}/perfil/show" class="header__login">Mi perfil</a>
                    <a href="{{baseUrl}}/login/logout" class="header__login">Cerrar sesión</a>
                {{/logueado}}

                {{^logueado}}
                    <a href="{{baseUrl}}/login/show" class="header__login">Ingresar</a>
                    <a href="{{baseUrl}}/registro/show" class="header__play">Registrarse</a>
                {{/logueado}}
            </div>
        </div>
        <script src="{{baseUrl}}/public/javascript/menu.js" defer></script>
    </div>
</header>
