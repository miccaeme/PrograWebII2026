
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Cerebrito | Juego de preguntas</title>
    <link rel="stylesheet" href="{{baseUrl}}/public/css/header.css">
    <link rel="stylesheet" href="{{baseUrl}}/public/css/footer.css">
    <link rel="stylesheet" href="{{baseUrl}}/public/css/app.css">
    <link rel="stylesheet" href="{{baseUrl}}/public/css/registro.css">
    <link rel="stylesheet" href="{{baseUrl}}/public/css/login.css">
    <link rel="stylesheet" href="{{baseUrl}}/public/css/lobby.css">
    <link rel="stylesheet" href="{{baseUrl}}/public/css/perfil.css">
    <link rel="stylesheet" href="{{baseUrl}}/public/css/pregunta.css">
    <link rel="stylesheet" href="{{baseUrl}}/public/css/admin-dashboard.css">

</head>
<body>
<header class="header">
    <div class="header__container">
        <a href="{{baseUrl}}/" class="header__logo">
            <img src="{{baseUrl}}/public/img/logo.png" alt="Logo Cerebrito">
        </a>
        <button class="header__menu-toggle" type="button" aria-label="Abrir menú;" aria-expanded="false" aria-controls="header-menu">
            <span></span><span></span><span></span>
        </button>
        <div class="header__menu" id="header-menu">
            <nav class="header__nav" aria-label="Navegación principal">
                {{#es_editor}}
                    <a href="{{baseUrl}}/editor/show" class="header__link">Panel editor</a>
                    <a href="{{baseUrl}}/editor/activas" class="header__link">Preguntas activas</a>
                    <a href="{{baseUrl}}/editor/reportadas" class="header__link">Reportadas</a>
                    <a href="{{baseUrl}}/categoria/show" class="header__link">Categorías</a>
                {{/es_editor}}
                {{#es_admin}}
                    <a href="{{baseUrl}}/admin/show" class="header__link">Panel admin</a>
                {{/es_admin}}
                {{^es_editor}}{{^es_admin}}
                    <a href="{{baseUrl}}/" class="header__link">Inicio</a>
                    <a href="{{baseUrl}}/ranking/show" class="header__link">Ranking</a>
                {{/es_admin}}{{/es_editor}}
            </nav>
            <div class="header__actions">
                {{#logueado}}
                    <span class="usuario-badge">¡Hola, {{nombre_usuario}}!</span>
                    <a href="{{baseUrl}}/perfil/show" class="header__login">Mi perfil</a>
                    <a href="{{baseUrl}}/login/logout" class="header__login">Cerrar sesión</a>
                {{/logueado}}

                {{^logueado}}
                    <a href="{{baseUrl}}/login/show" class="header__login">Ingresar</a>
                    <a href="{{baseUrl}}/registro/show" class="header__play">Registrarse</a>
                {{/logueado}}
            </div>
        </div>
        <button id="boton-sonido" class="header__sonido" type="button" aria-pressed="false" aria-label="Silenciar sonido" title="Silenciar sonido">
            <svg class="header__sonido-icono header__sonido-icono--activo" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M11 5 6 9H3v6h3l5 4z"/>
                <path d="M15.5 8.5a5 5 0 0 1 0 7"/>
                <path d="M18.5 5.5a9 9 0 0 1 0 13"/>
            </svg>
            <svg class="header__sonido-icono header__sonido-icono--silenciado" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M11 5 6 9H3v6h3l5 4z"/>
                <path d="m16 9 5 6"/>
                <path d="m21 9-5 6"/>
            </svg>
        </button>
        <script src="{{baseUrl}}/public/javascript/menu.js" defer></script>
        <script src="{{baseUrl}}/public/javascript/sonido.js" defer></script>
    </div>
</header>
