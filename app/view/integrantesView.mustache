<div class="container mt-4">
    <h1>{{mensaje}}</h1>


    <table class="table table-striped">
        <thead>
            <tr>
                <th>Nombre</th>
                <th>Apellido</th>
                <th>DNI</th>
            </tr>
        </thead>
        <tbody>
            {{#integrantes}}
