<main class="integrantes-page">
    <section class="integrantes-card" aria-labelledby="integrantes-titulo">
        <h1 class="integrantes-titulo" id="integrantes-titulo">{{mensaje}}</h1>

        <table class="integrantes-tabla">
        <thead>
            <tr>
                <th>Nombre</th>
                <th>Apellido</th>
                <th>DNI</th>
            </tr>
        </thead>
        <tbody>
            {{#integrantes}}
            <tr>
                <td>{{nombre}}</td>
                <td>{{apellido}}</td>
                <td>{{dni}}</td>
            </tr>
            {{/integrantes}}
        </tbody>
        </table>
    </section>
</main>
