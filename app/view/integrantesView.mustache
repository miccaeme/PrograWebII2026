<main class="integrantes-page">
    <section class="integrantes-card" aria-labelledby="integrantes-titulo">
        {{#logueado}}
            <div class="w3-panel w3-pale-green w3-round-large w3-padding-16 w3-center" style="margin-bottom: 2rem;">
                <h2 style="margin: 0; color: var(--cerebrito-ink, #2B2D42);">
                    ¡Bienvenido/a, <strong>{{nombre_usuario}}</strong>! 👋
                </h2>
            </div>
        {{/logueado}}



       <h1 class="integrantes-titulo" id="integrantes-titulo">{{mensaje}}</h1>

        <table class="integrantes-tabla">
        <thead>
            <tr>
                <th>Nombre</th>
                <th>Apellido</th>
                <th>DNI</th>
            </tr>
        </thead>
        <tbody>


            {{#integrantes}}
            <tr>
                <td>{{nombre}}</td>
                <td>{{apellido}}</td>
                <td>{{dni}}</td>
            </tr>
            {{/integrantes}}


        </tbody>
        </table>
    </section>
</main>
