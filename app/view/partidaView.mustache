{{> header}}
<link rel="stylesheet" href="{{baseUrl}}/public/css/partida.css">

<main class="partida-contenedor">
    <div class="partida-card" id="partida-tarjeta-principal"
         data-color="{{categoria_color}}"
         data-categoria-id="{{categoria_id}}">


        <div id="fase-sorteo" class="partida-fase-sorteo">
            <header class="partida-encabezado">
                <h2 class="partida-titulo">Girando la ruleta...</h2>
                <p class="partida-subtitulo">Eligiendo la categoría para tu próxima pregunta</p>
            </header>

            <div class="carrusel-marco">
                <div id="carrusel-tira" class="carrusel-tira">
                    {{#categorias_carrusel}}
                        <div class="categoria-tarjeta-item" style="border-left: 6px solid {{color}};" data-color="{{color}}" data-id="{{id}}">
                            <span class="categoria-tarjeta-icono">🧠</span>
                            <span class="categoria-tarjeta-nombre">{{nombre}}</span>
                        </div>
                    {{/categorias_carrusel}}
                </div>
            </div>
        </div>

        <!--  Pregunta y Respuestas  -->
        <div id="fase-pregunta" class="partida-fase-pregunta" style="display: none;">


            <div id="banner-categoria" class="partida-banner" style="background: {{categoria_color}};">
                <div class="partida-banner__info">
                    <span class="partida-banner__label">Categoría asignada</span>
                    <strong class="partida-banner__nombre">{{categoria_nombre}}</strong>
                </div>
                <div class="partida-banner__puntos">
                    <span class="partida-banner__valor">{{puntaje_actual}}</span>
                    <span class="partida-banner__sub">PUNTOS</span>
                </div>
            </div>

            <!-- Pregunta -->
            <div class="partida-pregunta-box">
                <h2 class="partida-enunciado">{{enunciado}}</h2>
            </div>

            <!-- Respuestas  -->
            <form method="POST" action="{{baseUrl}}/partida/responder" class="partida-respuestas-lista">
                {{#respuestas}}
                    <button type="submit" name="id_respuesta" value="{{id}}" class="partida-btn-respuesta">
                        {{texto}}
                    </button>
                {{/respuestas}}
            </form>

            <section id="temporizador" class="temporizador" aria-label="Tiempo para responder">
                <div class="temporizador__encabezado">
                    <span>Tiempo restante</span>
                    <output id="temporizador-segundos" aria-live="off">15</output>
                </div>
                <div id="temporizador-progreso" class="temporizador__pista" role="progressbar" aria-label="Tiempo restante" aria-valuemin="0" aria-valuemax="15" aria-valuenow="15">
                    <span id="temporizador-barra" class="temporizador__barra"></span>
                </div>
            </section>


        </div>

    </div>

    <div id="modal-tiempo" class="modal-tiempo" role="dialog" aria-modal="true" aria-labelledby="modal-tiempo-titulo" aria-describedby="modal-tiempo-mensaje" hidden>
        <div class="modal-tiempo__contenido">
            <h2 id="modal-tiempo-titulo">¡Tiempo finalizado!</h2>
            <p id="modal-tiempo-mensaje">Se terminó el tiempo para responder.</p>
            <div class="modal-tiempo__acciones">
                <a id="accion-jugar-otra-vez" class="modal-tiempo__boton modal-tiempo__boton--principal" href="{{baseUrl}}/partida/nueva">Jugar otra vez</a>
                <a class="modal-tiempo__boton modal-tiempo__boton--secundario" href="{{baseUrl}}/lobby/show">Ir al inicio</a>
            </div>
        </div>
    </div>
</main>

<script>
    document.addEventListener("DOMContentLoaded", () => {
        const tira = document.getElementById("carrusel-tira");
        const faseSorteo = document.getElementById("fase-sorteo");
        const fasePregunta = document.getElementById("fase-pregunta");
        const tarjetaPrincipal = document.getElementById("partida-tarjeta-principal");
        const segundosTemporizador = document.getElementById("temporizador-segundos");
        const progresoTemporizador = document.getElementById("temporizador-progreso");
        const barraTemporizador = document.getElementById("temporizador-barra");
        const temporizador = document.getElementById("temporizador");
        const modalTiempo = document.getElementById("modal-tiempo");
        const accionJugarOtraVez = document.getElementById("accion-jugar-otra-vez");
        const formularioRespuestas = fasePregunta.querySelector("form");

        const colorFinal = tarjetaPrincipal.getAttribute("data-color");
        const idGanador = tarjetaPrincipal.getAttribute("data-categoria-id");

        const items = Array.from(tira.querySelectorAll(".categoria-tarjeta-item"));
        if (items.length === 0) return;


        let indiceDestino = items.findIndex(el => el.getAttribute("data-id") == idGanador);
        if (indiceDestino === -1) indiceDestino = 0;

        // Da 3 vueltas completas (vueltas * items.length) y frena en el índice exacto
        const vueltasCompletas = 3;
        const totalPasos = (vueltasCompletas * items.length) + indiceDestino;

        let pasoActual = 0;
        let indice = 0;
        let velocidad = 60;
        let intervaloTemporizador = null;
        let temporizadorFinalizado = false;
        let instanteFinalTemporizador = 0;

        function detenerTemporizador() {
            if (intervaloTemporizador !== null) {
                window.clearInterval(intervaloTemporizador);
                intervaloTemporizador = null;
            }
        }

        function finalizarTemporizador() {
            detenerTemporizador();
            if (temporizadorFinalizado) return;

            temporizadorFinalizado = true;
            formularioRespuestas.querySelectorAll("button").forEach(boton => {
                boton.disabled = true;
            });
            modalTiempo.hidden = false;
            accionJugarOtraVez.focus();
        }

        function iniciarTemporizador() {
            detenerTemporizador();
            temporizadorFinalizado = false;
            const duracionTemporizador = 15;
            instanteFinalTemporizador = Date.now() + duracionTemporizador * 1000;

            function actualizarTemporizador() {
                const milisegundosRestantes = Math.max(0, instanteFinalTemporizador - Date.now());
                const segundosRestantes = Math.ceil(milisegundosRestantes / 1000);
                const porcentajeRestante = (milisegundosRestantes / (duracionTemporizador * 1000)) * 100;

                segundosTemporizador.value = segundosRestantes;
                barraTemporizador.style.width = `${porcentajeRestante}%`;
                progresoTemporizador.setAttribute("aria-valuenow", String(segundosRestantes));
                temporizador.classList.toggle("temporizador--urgente", segundosRestantes <= 5);

                if (milisegundosRestantes <= 0) {
                    finalizarTemporizador();
                }
            }

            actualizarTemporizador();
            intervaloTemporizador = window.setInterval(actualizarTemporizador, 100);
        }

        formularioRespuestas.addEventListener("submit", evento => {
            if (Date.now() >= instanteFinalTemporizador) {
                finalizarTemporizador();
            }
            if (temporizadorFinalizado) {
                evento.preventDefault();
                return;
            }
            detenerTemporizador();
        });

        modalTiempo.addEventListener("click", evento => {
            if (evento.target === modalTiempo) evento.preventDefault();
        });

        document.addEventListener("keydown", evento => {
            if (!modalTiempo.hidden && evento.key === "Escape") {
                evento.preventDefault();
            }
        });

        window.addEventListener("pagehide", detenerTemporizador, { once: true });

        function girarRuleta() {
            items.forEach(el => el.classList.remove("activa"));
            items[indice].classList.add("activa");

            pasoActual++;

            if (pasoActual <= totalPasos) {
                indice = (indice + 1) % items.length;

                if (pasoActual > totalPasos - 6) {
                    velocidad += 45;
                } else if (pasoActual > totalPasos - 12) {
                    velocidad += 15;
                }

                setTimeout(girarRuleta, velocidad);
            } else {

                setTimeout(() => {
                    faseSorteo.style.display = "none";
                    fasePregunta.style.display = "flex";

                    tarjetaPrincipal.style.borderTop = `6px solid ${colorFinal}`;
                    tarjetaPrincipal.style.boxShadow = `0 16px 42px ${colorFinal}33`;
                    iniciarTemporizador();
                }, 600);
            }
        }
        girarRuleta();
    });
</script>

{{> footer}}
