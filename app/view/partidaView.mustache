{{> header}}
<link rel="stylesheet" href="{{baseUrl}}/public/css/partida.css">

<main class="partida-contenedor">
    <div class="partida-card" id="partida-tarjeta-principal"
         data-color="{{categoria_color}}"
         data-categoria-id="{{categoria_id}}">


        <div id="fase-sorteo" class="partida-fase-sorteo">
            <header class="partida-encabezado">
                <h2 class="partida-titulo">Girando la ruleta...</h2>
                <p class="partida-subtitulo">Eligiendo la categoría para tu próxima pregunta</p>
            </header>

            <div class="carrusel-marco">
                <div id="carrusel-tira" class="carrusel-tira">
                    {{#categorias_carrusel}}
                        <div class="categoria-tarjeta-item" style="border-left: 6px solid {{color}};" data-color="{{color}}" data-id="{{id}}">
                            <span class="categoria-tarjeta-icono">🧠</span>
                            <span class="categoria-tarjeta-nombre">{{nombre}}</span>
                        </div>
                    {{/categorias_carrusel}}
                </div>
            </div>
        </div>

        <!--  Pregunta y Respuestas  -->
        <div id="fase-pregunta" class="partida-fase-pregunta" style="display: none;">


            <div id="banner-categoria" class="partida-banner" style="background: {{categoria_color}};">
                <div class="partida-banner__info">
                    <span class="partida-banner__label">Categoría asignada</span>
                    <strong class="partida-banner__nombre">{{categoria_nombre}}</strong>
                </div>
                <div class="partida-banner__puntos">
                    <span class="partida-banner__valor">{{puntaje_actual}}</span>
                    <span class="partida-banner__sub">PUNTOS</span>
                </div>
            </div>

            <!-- Pregunta -->
            <div class="partida-pregunta-box">
                <h2 class="partida-enunciado">{{enunciado}}</h2>
            </div>

            <!-- Respuestas  -->
            <form method="POST" action="{{baseUrl}}/partida/responder" class="partida-respuestas-lista">
                {{#respuestas}}
                    <button type="submit" name="id_respuesta" value="{{id}}" class="partida-btn-respuesta">
                        {{texto}}
                    </button>
                {{/respuestas}}
            </form>

            <details class="partida-reportar">
                <summary class="partida-reportar__resumen">🚩 Reportar pregunta</summary>
                <form method="POST" action="{{baseUrl}}/pregunta/reportar" class="partida-reportar__form">
                    <select name="motivo" class="partida-reportar__select" required>
                        <option value="">¿Qué problema tiene?</option>
                        <option value="La respuesta correcta es otra">La respuesta correcta es otra</option>
                        <option value="La pregunta está mal escrita">La pregunta está mal escrita</option>
                        <option value="Contenido inapropiado">Contenido inapropiado</option>
                        <option value="Pregunta repetida o confusa">Pregunta repetida o confusa</option>
                        <option value="Otro">Otro</option>
                    </select>
                    <button type="submit" class="partida-reportar__boton">Enviar reporte</button>
                </form>
            </details>

        </div>

    </div>
</main>

<script>
    document.addEventListener("DOMContentLoaded", () => {
        const tira = document.getElementById("carrusel-tira");
        const faseSorteo = document.getElementById("fase-sorteo");
        const fasePregunta = document.getElementById("fase-pregunta");
        const tarjetaPrincipal = document.getElementById("partida-tarjeta-principal");

        const colorFinal = tarjetaPrincipal.getAttribute("data-color");
        const idGanador = tarjetaPrincipal.getAttribute("data-categoria-id");

        const items = Array.from(tira.querySelectorAll(".categoria-tarjeta-item"));
        if (items.length === 0) return;


        let indiceDestino = items.findIndex(el => el.getAttribute("data-id") == idGanador);
        if (indiceDestino === -1) indiceDestino = 0;

        // Da 3 vueltas completas (vueltas * items.length) y frena en el índice exacto
        const vueltasCompletas = 3;
        const totalPasos = (vueltasCompletas * items.length) + indiceDestino;

        let pasoActual = 0;
        let indice = 0;
        let velocidad = 60;

        function girarRuleta() {
            items.forEach(el => el.classList.remove("activa"));
            items[indice].classList.add("activa");

            pasoActual++;

            if (pasoActual <= totalPasos) {
                indice = (indice + 1) % items.length;

                if (pasoActual > totalPasos - 6) {
                    velocidad += 45;
                } else if (pasoActual > totalPasos - 12) {
                    velocidad += 15;
                }

                setTimeout(girarRuleta, velocidad);
            } else {

                setTimeout(() => {
                    faseSorteo.style.display = "none";
                    fasePregunta.style.display = "flex";

                    tarjetaPrincipal.style.borderTop = `6px solid ${colorFinal}`;
                    tarjetaPrincipal.style.boxShadow = `0 16px 42px ${colorFinal}33`;
                }, 600);
            }
        }
        girarRuleta();
    });
</script>

{{> footer}}