{{> header}}
<main class="perfil perfilCompartido">
    <section class="perfil__tarjeta perfilCompartidoTarjeta">
        {{#usuario}}
            <div class="perfil__encabezado">
                <h1 class="perfil__titulo">Perfil compartido</h1>
            </div>

            <section class="perfil__presentacion perfilCompartidoPresentacion">
                <div class="perfil__marco">
                    {{#foto_perfil}}
                        <img class="perfil__foto" src="{{baseUrl}}/{{foto_perfil}}" alt="Foto de perfil de {{nombre_usuario}}">
                    {{/foto_perfil}}
                    {{^foto_perfil}}
                        <div class="perfil__foto perfil__foto--vacia" aria-hidden="true"></div>
                    {{/foto_perfil}}
                </div>

                <div class="perfil__identidad">
                    <p class="perfil__nombre">{{nombre_completo}}</p>
                    <p class="perfil__usuario">@{{nombre_usuario}}</p>
                </div>

                <img class="perfil__decoracion" src="{{baseUrl}}/public/img/Cerebro%20estudioso%20con%20idea%20brillante.png" alt="" aria-hidden="true">
            </section>

                        <section class="perfil__seccion" aria-labelledby="perfilCompartidoDatosTitulo">
                <h2 class="perfil__subtitulo" id="perfilCompartidoDatosTitulo">Datos del jugador</h2>
                <dl class="perfil__datos">
                    <div class="perfil__dato">
                        <div class="perfil__detalle"><dt class="perfil__etiquetaDato">Puntaje total</dt><dd class="perfil__valorDato">{{puntaje_total}} pts</dd></div>
                    </div>
                    <div class="perfil__dato">
                        <div class="perfil__detalle"><dt class="perfil__etiquetaDato">Partidas jugadas</dt><dd class="perfil__valorDato">{{partidas_jugadas}}</dd></div>
                    </div>
                    <div class="perfil__dato">
                        <div class="perfil__detalle"><dt class="perfil__etiquetaDato">País</dt><dd class="perfil__valorDato">{{pais}}</dd></div>
                    </div>
                </dl>
            </section>

            <section class="perfil__seccion codigoQr" aria-labelledby="codigoQrTitulo">
                <div class="codigoQrContenido">
                    <h2 class="perfil__subtitulo" id="codigoQrTitulo">Perfil de {{nombre_usuario}}</h2>
                    <p class="codigoQrTexto">Escaneá este código para abrir este perfil desde tu celular.</p>
                </div>
                <img class="codigoQrImagen" src="{{codigo_qr_data_uri}}" alt="Código QR para abrir el perfil de {{nombre_usuario}}">
            </section>
        {{/usuario}}

        {{#noEncontrado}}
            <div class="perfil__encabezado">
                <h1 class="perfil__titulo">Perfil no disponible</h1>
            </div>
            <p class="perfilCompartidoMensaje">El enlace no es válido o el perfil ya no está disponible.</p>
        {{/noEncontrado}}
    </section>
</main>
{{> footer}}
