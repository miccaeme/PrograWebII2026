<main class="registro">
    <section class="registro__presentacion">
        <div class="registro__presentacion-contenido">
            <img class="registro__personaje" src="{{baseUrl}}/public/img/Cerebro%20kawaii%20graduado%20y%20triunfante.png" alt="Cerebrito, la mascota del juego">
            <h1 class="registro__titulo-presentacion">Creá tu cuenta y empezá a jugar</h1>
            <p class="registro__descripcion">Sumate a Cerebrito, poné a prueba tus conocimientos, ganá puntos y competí con jugadores de todo el mundo</p>
        </div>
    </section>

    <section class="registro__panel">
        <div class="registro__tarjeta">
            <h2 class="registro__titulo">Crear cuenta</h2>
            <p class="registro__subtitulo">Completá tus datos para unirte a Cerebrito</p>

            <form id="registro-form" class="registro__formulario" method="POST" action="{{baseUrl}}/index.php?controller=registro&amp;method=procesar" enctype="multipart/form-data">
            {{#exito}}
                <p class="exito registro__exito">{{exito}}</p>
            {{/exito}}

            <form id="registro-form" class="registro__formulario" method="POST" action="{{baseUrl}}/registro/procesar">
                <p class="registro__campo registro__campo--ancho">
                    <label class="registro__etiqueta">Nombre completo</label>
                    <input class="w3-input registro__entrada" type="text" name="nombre_completo" value="{{nombre_completo}}" maxlength="100" aria-describedby="nombre-completo-error">
                    <small id="nombre-completo-error" class="field-error registro__error" role="alert">{{errores.nombre_completo}}</small>
                </p>

                <p class="registro__campo">
                    <label class="registro__etiqueta">Año de nacimiento</label>
                    <input class="w3-input registro__entrada" type="number" name="anio_nacimiento" value="{{anio_nacimiento}}" min="1900" max="2026" step="1" aria-describedby="anio-error">
                    <small id="anio-error" class="field-error registro__error" role="alert">{{errores.anio_nacimiento}}</small>
                </p>

                <p class="registro__campo">
                    <label class="registro__etiqueta">Sexo</label>
                    <select class="w3-select registro__entrada" name="sexo">
                        <option value="">Elegí una opción</option>
                        <option value="M" {{#sexo_M}}selected{{/sexo_M}}>Masculino</option>
                        <option value="F" {{#sexo_F}}selected{{/sexo_F}}>Femenino</option>
                        <option value="N" {{#sexo_N}}selected{{/sexo_N}}>Prefiero no cargarlo</option>
                    </select>
                    <small id="sexo-error" class="field-error registro__error" role="alert">{{errores.sexo}}</small>
                </p>

                <p class="registro__campo">
                    <label class="registro__etiqueta">Email</label>
                    <input class="w3-input registro__entrada" type="email" name="email" value="{{email}}" maxlength="150" aria-describedby="email-error">
                    <small id="email-error" class="field-error registro__error" role="alert">{{errores.email}}</small>
                </p>

                <p class="registro__campo">
                    <label class="registro__etiqueta">Nombre de usuario</label>
                    <input class="w3-input registro__entrada" type="text" name="nombre_usuario" value="{{nombre_usuario}}" minlength="1" maxlength="30" aria-describedby="usuario-error">
                    <small id="usuario-error" class="field-error registro__error" role="alert">{{errores.nombre_usuario}}</small>
                </p>

                <div class="registro__foto-perfil">
                    <label class="registro__foto-boton" for="foto-perfil">Seleccionar foto</label>
                    <input id="foto-perfil" class="registro__foto-entrada" type="file" name="foto_perfil" accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp" aria-describedby="foto-perfil-error">
                    <div class="registro__foto-marco">
                        <div id="avatar-predeterminado" class="registro__avatar-predeterminado" aria-hidden="true"></div>
                        <img id="foto-perfil-vista-previa" class="registro__foto-vista-previa" alt="Vista previa de la foto de perfil" hidden>
                    </div>
                    <small id="foto-perfil-error" class="registro__foto-error" role="alert"></small>
                </div>

                <p class="registro__campo">
                    <label class="registro__etiqueta">Contraseña</label>
                    <input class="w3-input registro__entrada" id="password" type="password" name="password" minlength="8" aria-describedby="password-error">
                    <small id="password-error" class="field-error registro__error" role="alert">{{errores.password}}</small>
                </p>

                <p class="registro__campo">
                    <label class="registro__etiqueta">Repetir contraseña</label>
                    <input class="w3-input registro__entrada" id="password-repetida" type="password" name="password_repetida" minlength="8" aria-describedby="password-repetida-error">
                    <small id="password-repetida-error" class="field-error registro__error" role="alert">{{errores.password_repetida}}</small>
                </p>

                <p class="registro__acciones registro__campo--ancho">
                    <button class="w3-button w3-blue w3-block registro__boton" type="submit">Registrarme</button>
                </p>

                <p class="registro__ingreso registro__campo--ancho">¿Ya tenés cuenta? <a class="registro__enlace" href="{{baseUrl}}/login/show">Ingresá acá</a></p>
            </form>
        </div>
    </section>
</main>

<script src="{{baseUrl}}/public/javascript/registro.js" defer></script>
