{{> header}}
<link rel="stylesheet" href="{{baseUrl}}/public/css/partida.css">
<link rel="stylesheet" href="{{baseUrl}}/public/css/resultado.css?v=1">
<main class="partida-contenedor">
    <div class="partida-card">

        <!-- Resultado -->
        <div class="resultado-fase">
            <header class="partida-encabezado">

                    <img src="{{baseUrl}}/public/img/cerebrito-triste.png" alt="Cerebrito triste" class="resultado-personaje">
                    <h2 class="partida-titulo" style="color: #ef4444;">¡Fin de la partida!</h2>
                    <p class="partida-subtitulo">Respuesta incorrecta. Tu racha terminó en esta ronda.</p>

            </header>

            <!-- Puntaje -->
            <div class="resultado-marcador">
                <div class="resultado-marcador-info">
                    <span class="resultado-marcador-etiqueta">Puntaje obtenido</span>
                    <strong class="resultado-marcador-puntos">{{puntaje}} <span class="resultado-maximo"></span></strong>
                </div>
                <div class="resultado-marcador-estado">
                        <span class="resultado-marcador-badge" style="background: rgba(239, 68, 68, 0.2); color: #ef4444;">Racha rota ❌</span>
                </div>
            </div>

            {{#respuesta_correcta}}
                <div class="resultado-solucion-box">
                    <div class="resultado-solucion-header">
                        <span class="solucion-badge-cat" style="background-color: {{categoria_color}};">{{categoria_nombre}}</span>
                        <span class="solucion-label">La respuesta correcta era:</span>
                    </div>

                    <p class="solucion-enunciado">"{{enunciado}}"</p>

                    <div class="solucion-respuesta-correcta">
                        <span class="solucion-icono">✓</span>
                        <strong>{{respuesta_correcta}}</strong>
                    </div>
                </div>
            {{/respuesta_correcta}}

            <details class="partida-reportar">
                <summary class="partida-reportar__resumen">Reportar pregunta</summary>
                <form method="POST" action="{{baseUrl}}/pregunta/reportar" class="partida-reportar__form">
                    <select name="motivo" class="partida-reportar__select" required>
                        <option value="">¿Qué problema tiene?</option>
                        <option value="La respuesta correcta es otra">La respuesta correcta es otra</option>
                        <option value="La pregunta está mal escrita">La pregunta está mal escrita</option>
                        <option value="Contenido inapropiado">Contenido inapropiado</option>
                        <option value="Pregunta repetida o confusa">Pregunta repetida o confusa</option>
                        <option value="Otro">Otro</option>
                    </select>
                    <button type="submit" class="partida-reportar__boton">Enviar reporte</button>
                </form>
            </details>

            <!-- Botones-->
            <div class="partida-respuestas-lista" style="margin-top: 10px;">
                <a href="{{baseUrl}}/partida/nueva" class="partida-btn-respuesta" style="background: #6655d9; color: #fff; border: 0; text-decoration: none;">
                    Jugar otra partida
                </a>
                <a href="{{baseUrl}}/lobby/show" class="partida-btn-respuesta" style="text-decoration: none;">
                    Volver al Lobby
                </a>
            </div>
        </div>

    </div>
</main>

{{> footer}}